<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:ovp="sap.ovp.ui"
xmlns:template="http://schemas.sap.com/sapui5/extension/sap.ui.core.template/1">
            <!-- Card's Content area code goes here -->

<ScrollContainer  width="100%" horizontal="true" vertical="true" focusable="true">



            <Table width="100%" items="{shipmentModel>/results}"  headerText="Shipment">
		
	
		<columns>
			<Column width="6rem">
				<Text text="{/#ZCSD_CUSTSOSHIPMENTType/Tknum/@sap:label}" />
			</Column>
			
			
			<Column width="6rem">
				<Text text="{/#ZCSD_CUSTSOSHIPMENTType/route/@sap:label}" />
			</Column>
			<Column width="6rem">
				<Text text="{/#ZCSD_CUSTSOSHIPMENTType/driver/@sap:label}" />
			</Column>
			<Column width="6rem">
				<Text text="{/#ZCSD_CUSTSOSHIPMENTType/trailer/@sap:label}" />
			</Column>
				<Column width="6rem">
				<Text text="{/#ZCSD_CUSTSOSHIPMENTType/vehicle/@sap:label}"/>
			</Column>
			<Column width="6rem">
				<Text text="{/#ZCSD_CUSTSOSHIPMENTType/shipcomplete/@sap:label}" />
			</Column>
            <Column width="6rem">
				<Text text="{/#ZCSD_CUSTSOSHIPMENTType/ShipmentHeaderStatus/@sap:label}" />
			</Column>
            <Column width="6rem"> 
				<Text text="{/#ZCSD_CUSTSOSHIPMENTType/starttime/@sap:label}" />
			</Column >

            <Column width="6rem">
				<Text text="{/#ZCSD_CUSTSOSHIPMENTType/endtime/@sap:label}" />
			</Column>
            <Column width="6rem">
				<Text text="{/#ZCSD_CUSTSOSHIPMENTType/laststoptime/@sap:label}" />
			</Column>
			
			
		</columns>
		<items>
			<ColumnListItem vAlign="Middle">
				<cells>
					<ObjectIdentifier titleActive="true" titlePress="onClickShipment"
					
						title="{shipmentModel>Tknum}"
						/>
					<Text
						text="{shipmentModel>route}" />
						<Text
						text="{shipmentModel>driver} ({shipmentModel>drivername})" />
						<Text
						text="{shipmentModel>trailer} ({shipmentModel>trailertext})" />


					
					<Text
						text="{shipmentModel>vehicle} ({shipmentModel>vehicletext})" />
                        <ObjectStatus state="{= ${shipmentModel>shipcomplete} === 'Yes' ? 'Success' : 'Error'}" icon="{= ${shipmentModel>shipcomplete} === 'yes' ? 'sap-icon://status-positive' : 'sap-icon://status-negative'}" text="{shipmentModel>shipcomplete}" />
                        
   						<ObjectStatus state="{= ${shipmentModel>ShipmentHeaderStatus} === 0 ? 'None' : ${shipmentModel>ShipmentHeaderStatus} === 2 ?  'Warning' : ${shipmentModel>ShipmentHeaderStatus} === 3 ?  'Success' : 'Error' }" icon="sap-icon://circle-task-2"/>

                        <Text text="{ path:'shipmentModel>starttime', type:'sap.ui.model.odata.type.Time'}" />

                         <Text text="{ path:'shipmentModel>endtime', type:'sap.ui.model.odata.type.Time'}" />

                         <Text text="{ path:'shipmentModel>laststoptime', type:'sap.ui.model.odata.type.Time'}" />
                        
				</cells>
			</ColumnListItem>		
				
		</items>
	</Table>
</ScrollContainer>

</core:FragmentDefinition>