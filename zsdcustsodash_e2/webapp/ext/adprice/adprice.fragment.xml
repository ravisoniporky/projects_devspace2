<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:ovp="sap.ovp.ui"
xmlns:template="http://schemas.sap.com/sapui5/extension/sap.ui.core.template/1">
            <!-- Card's Content area code goes here -->


 <ScrollContainer  width="100%" horizontal="true" vertical="true" focusable="true">



            <Table  items="{adPriceModel>/results}"  headerText="Ad Price">
		
	
		<columns>
			<Column width="4rem">
				<Text text="{/#ZCSD_CUSTSODASHADPRICEType/Material/@sap:label}" />
			</Column>
			<Column width="4rem">
				<Text text="{/#ZCSD_CUSTSODASHADPRICEType/OldMaterial/@sap:label}" />
			</Column>
			
			
			<Column width="2rem">
				<Text text="{/#ZCSD_CUSTSODASHADPRICEType/ConditionAmount/@sap:label}" />
			</Column>
			<Column width="2rem">
				<Text text="{/#ZCSD_CUSTSODASHADPRICEType/ConditionUnit/@sap:label}" />
			</Column>
			<Column width="2rem">
				<Text text="{/#ZCSD_CUSTSODASHADPRICEType/ValidStart/@sap:label}" />
			</Column>
				<Column width="2rem">
				<Text text="{/#ZCSD_CUSTSODASHADPRICEType/ValidEnd/@sap:label}" />
			</Column>

			<Column width="2rem">
				<Text text="{/#ZCSD_CUSTSODASHADPRICEType/AccessLevel/@sap:label}" />
			</Column>
			
           
			
			
		</columns>
		<items>
			<ColumnListItem vAlign="Middle">
				<cells>
					<Text text="{adPriceModel>Material} ({adPriceModel>MaterialDescription})"/>
										<Text text="{adPriceModel>OldMaterial}"/>

					<Text text="{adPriceModel>ConditionAmount} {adPriceModel>Currency}" />
						<Text
						text="{adPriceModel>ConditionUnit}" />
						<Text
						text="{ path:'adPriceModel>ValidStart', type:'sap.ui.model.odata.type.Date'}" />

<Text text="{ path:'adPriceModel>ValidEnd', type:'sap.ui.model.odata.type.Date'}" />
						
<Text
						text="{adPriceModel>AccessLevel}" />
					
		
                        
				</cells>
			</ColumnListItem>		
				
		</items>
	</Table>
</ScrollContainer>


</core:FragmentDefinition>