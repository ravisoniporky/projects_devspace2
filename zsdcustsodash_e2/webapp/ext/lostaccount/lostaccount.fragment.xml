<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:ovp="sap.ovp.ui" 
    xmlns:smartTable="sap.ui.comp.smarttable" 
    xmlns:template="http://schemas.sap.com/sapui5/extension/sap.ui.core.template/1" 
    xmlns:ui="sap.ui.table"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

    <VBox width="100%" height="100%" >
        <smartTable:SmartTable
            tableType="AnalyticalTable"
            initiallyVisibleFields="TimeRollup,Material,ProductHierarchy,OldMaterial,MaterialDescritpion"
            requestAtLeastFields="TimeRollup,Material,ProductHierarchy,OldMaterial,MaterialDescritpion,CriticalitySales"
            id="LineItemsSmartTable_lostaccount"
            entitySet="ZCSD_CUSTSODASHVM"
            smartFilterId="smartFilterBar"
            useExportToExcel="true"
            beforeExport="onBeforeExport"
            useVariantManagement="true"
            header="Void Matrix"
            beforeRebindTable="onBeforeRebindTable"
            showFullScreenButton="true"
            persistencyKey="tablearprofit_voidmatrx"
            class="sapUiResponsiveContentPadding"
            enableAutoColumnWidth="true"
            enableAutoBinding="true"
            growingThreshold="20"
            alignContent="Stretch"
            alignItems="Stretch"
            displayInline="true"
            justifyContent="Center"
			  selectionMode="None"
			  enableCopy="false"
        >
		   <smartTable:customData>
        <core:CustomData key="enableSelectAll" value="false" />
    </smartTable:customData>
            <!-- KEY: Remove hardcoded visibleRowCount, use visibleRowCountMode Auto -->
            <ui:AnalyticalTable 
                visibleRowCountMode="Auto"
                minAutoRowCount="10"
				 selectionMode="None"
				
            />

            <smartTable:customToolbar>
                <OverflowToolbar design="Transparent">
                    <ToolbarSpacer/>
                    <ComboBox
                        id="comboBox"
                        placeholder="Select Timerollup"
                        selectionChange="onSelectTimeRollup"
                        selectedKey="4O4"
                        items="{/ZBSD_TIMEROLLUP}">
                        <core:Item key="{timerollup}" text="{timerollup} - {timerolluptext}" />
                    </ComboBox>
                </OverflowToolbar>
            </smartTable:customToolbar>
        </smartTable:SmartTable>
    </VBox>
</core:FragmentDefinition>