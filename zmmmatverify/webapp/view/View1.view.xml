<mvc:View controllerName="customer.porky.zmmmatverify.controller.View1"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true" xmlns:smartTable="sap.ui.comp.smarttable" xmlns:sf="sap.ui.comp.smartfilterbar" xmlns:core="sap.ui.core"
	xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"  xmlns:ndc="sap.ndc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">

    	<headerContent>
			<!-- <Button icon="sap-icon://bar-code" tooltip="Share" text="Barcode" press="onScanBarcode"/> -->
            	<ndc:BarcodeScannerButton
			id="sampleBarcodeScannerButton"
			scanSuccess="onScanSuccess"
			scanFail="onScanError"
			inputLiveUpdate="onScanLiveupdate"
			dialogTitle="Barcode Scanner Button Sample"
		/>
		</headerContent>
        <content >

<smartFilterBar:SmartFilterBar id="smartFilter_visitF4" entitySet="ZC_Product"
		 persistencyKey="smarttableCustF4_filter1" enableBasicSearch="true" useToolbar="true">
			<smartFilterBar:controlConfiguration>
				<smartFilterBar:ControlConfiguration
					id="ccProduct"
					key="Product"
					visibleInAdvancedArea="false"/>
			</smartFilterBar:controlConfiguration>
		</smartFilterBar:SmartFilterBar>

            	<smartTable:SmartTable id="smartTable_visitF4" entitySet="ZC_Product"  smartFilterId="smartFilter_visitF4"

            requestAtLeastFields="Product"
			initialise="onSmartTableInit"
			beforeRebindTable="onBeforeRebindVisit_F4"
			demandPopin="true"
			displayInline="true"
			showTablePersonalisation="true"
			afterVariantSave="onAfterVariantSaveVisit"


		 tableType="ResponsiveTable" useExportToExcel="true"
		 beforeExport="onBeforeExport" useVariantManagement="true" useTablePersonalisation="true"
		 enableAutoColumnWidth="true"
		 header="Visits" showRowCount="true" persistencyKey="smarttableCustF41_visit"
		   class="sapUiResponsiveContentPadding"
		    >
		</smartTable:SmartTable >


        </content>
    </Page>
</mvc:View>
