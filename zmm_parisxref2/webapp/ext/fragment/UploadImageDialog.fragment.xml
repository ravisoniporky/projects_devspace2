<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:l="sap.ui.layout">
    <Dialog
        title="Upload Image"
        contentWidth="600px"
        contentHeight="650px"
        resizable="true"
        draggable="true">
        <content>
            <ScrollContainer
                height="100%"
                width="100%"
                vertical="true">
                <VBox class="sapUiMediumMargin">
                    <!-- Paris Code Display -->
                    <VBox class="sapUiSmallMarginBottom">
                        <Label text="Paris Code:" class="sapUiTinyMarginBottom"/>
                        <Text text="{Pariscode}" class="sapUiSmallMarginBottom"/>
                    </VBox>
                    
                    <!-- Unit Selection -->
                    <VBox class="sapUiSmallMarginBottom">
                        <Label text="Unit:" required="true" class="sapUiTinyMarginBottom"/>
                        <Select
                            id="unitSelect"
                            width="100%">
                            <items>
                                <core:Item key="CS" text="Case"/>
                                <core:Item key="EA" text="Each"/>
                            </items>
                        </Select>
                    </VBox>
                    
                    <!-- File Upload -->
                    <VBox class="sapUiSmallMarginBottom">
                        <Label text="Image File:" required="true" class="sapUiTinyMarginBottom"/>
                        <u:FileUploader
                            id="fileUploader"
                            name="uploadFile"
                            uploadUrl=""
                            fileType="jpg,jpeg,png,gif,bmp"
                            mimeType="image/jpeg,image/png,image/gif,image/bmp"
                            placeholder="Choose an image file..."
                            change=".onFileChange"
                            style="Emphasized"
                            width="100%"
                            buttonText="Browse..."/>
                        
                        <Text 
                            text="Supported formats: JPG, PNG, GIF, BMP (Max 5MB)" 
                            class="sapUiTinyMarginTop"/>
                    </VBox>

                    <!-- Image Preview Section -->
                    <VBox 
                        visible="{viewModel>/preview/visible}"
                        class="sapUiSmallMarginTop">
                        <l:HorizontalLayout class="sapUiSmallMarginBottom">
                            <core:Icon 
                                src="sap-icon://camera" 
                                color="#0854A0"
                                class="sapUiTinyMarginEnd"/>
                            <Label 
                                text="Image Preview:" 
                                design="Bold"/>
                        </l:HorizontalLayout>
                        
                        <VBox 
                            alignItems="Center"
                            class="sapUiSmallMarginTop"
                            width="100%">
                            <Image
                                src="{viewModel>/preview/src}"
                                width="100%"
                                maxWidth="500px"
                                densityAware="false"
                                decorative="false"
                                alt="Preview Image"
                                class="sapUiSmallMarginBottom"/>
                            
                            <Text 
                                text="{viewModel>/preview/fileName}"
                                class="sapUiTinyMarginTop"/>
                        </VBox>
                    </VBox>

                    <!-- Info Panel -->
                    <MessageStrip
                        text="Select a unit and image file. Preview will be displayed before upload."
                        type="Information"
                        showIcon="true"
                        class="sapUiSmallMarginTop"/>
                </VBox>
            </ScrollContainer>
        </content>
        <beginButton>
            <Button
                text="Upload"
                type="Emphasized"
                icon="sap-icon://upload"
                enabled="{viewModel>/preview/visible}"
                press=".onUploadPress"/>
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCancelUpload"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>