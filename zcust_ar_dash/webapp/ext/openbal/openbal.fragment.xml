<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:ovp="sap.ovp.ui" xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
xmlns:template="http://schemas.sap.com/sapui5/extension/sap.ui.core.template/1">
            <!-- Card's Content area code goes here -->

            	<VBox class="sapUiSmallMargin">
		<f:SimpleForm 
			editable="true"
			layout="ResponsiveGridLayout"
			title="Customer Balance"
			labelSpanXL="3"
			labelSpanL="3"
			labelSpanM="3"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false" >


			<f:toolbar>
			<Toolbar  >
							<Title text="Open Balance"  />
<ToolbarSpacer />
					
					<Button icon="sap-icon://action"
						press="onClickHeader" />
			</Toolbar>
			</f:toolbar>


			<f:content>
				<ObjectIdentifier title="Customer" emptyIndicatorMode= "Auto" titleActive="true" />
				<Text  text="{customerData1>/Customer}" />
				<ObjectIdentifier title="Open Balance" emptyIndicatorMode= "Auto" titleActive="true" />
				<Text text="${path: 'customerData1>/OpenBalance', type:'sap.ui.model.type.Float'}" />
				
	
			
			</f:content>
		</f:SimpleForm>
	</VBox>
</core:FragmentDefinition>