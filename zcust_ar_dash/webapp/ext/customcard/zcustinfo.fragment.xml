<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:ovp="sap.ovp.ui" xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
	
xmlns:template="http://schemas.sap.com/sapui5/extension/sap.ui.core.template/1">
            <!-- Card's Content area code goes here -->
           	<!-- <VBox class="sapUiSmallMargin" height="80%"> -->

			<Table headerText="Customer Details" >
		
			<headerToolbar>
			<OverflowToolbar>
				<content>
							<Title text="Customer Details - {customerData>/CustomerName}"  />
					<ToolbarSpacer />

					<Button icon="sap-icon://save"
						press="onSaveUpdate" />
					
					<Button icon="sap-icon://action"
						press="onClickHeader" />
				</content>
			</OverflowToolbar>
		</headerToolbar>
		<columns>
			<Column>
				<Text  />
			</Column>
			<Column>
				<Text />
			</Column>
			<Column>
				<Text  />
			</Column>
			<Column>
				<Text />
			</Column>
			
			
		</columns>
		<items>

				<ColumnListItem vAlign="Middle">
				<cells>


					<ObjectIdentifier
					titleActive="true"
						title="Customer"
						/>
					<Text
						text="{customerData>/Customer}" />
						
						
						<ObjectIdentifier titleActive="true"
						title="Customer Name"
						/>
					<Text
						text="{customerData>/CustomerName}" />


				</cells>
			</ColumnListItem>



			<ColumnListItem vAlign="Middle">
				<cells>


					<ObjectIdentifier
					titleActive="true"
						title="Store No"
						/>
					<Text
						text="{customerData>/StoreNo}" />
						
						
						<ObjectIdentifier titleActive="true"
						title="Previous Account"
						/>
					<Text
						text="{customerData>/PrevAcct}" />


				</cells>
			</ColumnListItem>
				
				<ColumnListItem vAlign="Middle">
				<cells>


					<ObjectIdentifier titleActive="true"
						title="Address"
						/>
					<Text
						text="{customerData>/Address}" />
							
							
							<ObjectIdentifier titleActive="true"
						title="Payment Terms"
						/>
					<Input
						value="{customerData>/PmntTerms}"
						valueState="{valueStateModel>/PmntTerms}" 
						valueStateText="{valueStateModel>/PmntTermsText}" 

						change="onChangePaymentTerms"
						showValueHelp="true"
						valueHelpRequest="onPaymentTermsValueHelp"
						editable="true"
						placeholder="Select Payment Terms..." />


				</cells>
			</ColumnListItem>
				<ColumnListItem vAlign="Middle">
				<cells>


				<ObjectIdentifier titleActive="true"
						title="Phone Number"
						/>
					<Text
						text="{customerData>/Telephone}" />


					<ObjectIdentifier titleActive="true"
						title="Customer Hierarchy"
						/>
					<Text
						text="{customerData>/CustHierL1}" />


				</cells>
			</ColumnListItem>

			<ColumnListItem vAlign="Middle">
				<cells>




					<ObjectIdentifier titleActive="true"
						title="Email ID"
						/>
					<Text
						text="{customerData>/EmailId}" />


					<ObjectIdentifier titleActive="true"
						title="Sales Support"
						/>
					<Text
						text="{customerData>/SalesSupport}" />




				</cells>
			</ColumnListItem>




				<ColumnListItem vAlign="Middle">
				<cells>
					<ObjectIdentifier titleActive="true"
						title="Sales Lead"
						/>
					<Input
						value="{customerData>/SalesLead}" 
						valueState="{valueStateModel>/SalesLead}" 
						valueStateText="{valueStateModel>/SalesLeadText}" 

						change="onChangeSalesLead"
						showValueHelp="true"
						valueHelpRequest="onSalesLeadValueHelp"
						editable="true"
					
						placeholder="Select Sales Lead..." />

						<ObjectIdentifier titleActive="true"
						title="Owner Name"
						/>
					<Text
						text="{customerData>/OwnerName}" />
						


				</cells>
			</ColumnListItem>




			<ColumnListItem vAlign="Middle">
				<cells>
					

						<ObjectIdentifier titleActive="true"
						title="Credit Limit"
						/>
					<Text
						text="$ { path: 'customerData>/CreditLimit',
        type: 'sap.ui.model.type.Float'}" />
						


				</cells>
			</ColumnListItem>
				
			
				
		</items>
	</Table>
		
	
</core:FragmentDefinition>