<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:ovp="sap.ovp.ui" xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
xmlns:template="http://schemas.sap.com/sapui5/extension/sap.ui.core.template/1">
            <!-- Card's Content area code goes here -->
            <VBox class="sapUiSmallMargin">
		<f:SimpleForm id="SimpleFormChange354"
			editable="true"
			layout="ResponsiveGridLayout"
			title="Payment Return for {customerData>/Customer}"
            
			labelSpanXL="3"
			labelSpanL="3"
			labelSpanM="3"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false" >
			<f:content>
				<ObjectIdentifier title="Last Return Check Date"  emptyIndicatorMode= "Auto" titleActive="true"/>
				<Text id="name" text="{path: 'customerData>/LastRetChkDt',type: 'sap.ui.model.type.Date', constraints:{displayFormat:'Date'}}" />
				
				<ObjectIdentifier title="Last Return Check Amount" emptyIndicatorMode= "Auto" titleActive="true" class="sapUiSmallMarginTop"/>
				<Text id="name1" text="$ {path: 'customerData>/LastRetChkAmt',  type:'sap.ui.model.type.Float'}" />

				

				
			</f:content>
		</f:SimpleForm>

      
	</VBox>
</core:FragmentDefinition>