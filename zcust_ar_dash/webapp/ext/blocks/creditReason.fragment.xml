<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:f="sap.ui.layout.form"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">
	<Dialog
		id="mainDialog"
		title="Credit Block Reason">
		<content>
			<VBox class="sapUiSmallMargin" id="formContainer" >
				<f:SimpleForm 
					editable="true"
					layout="ColumnLayout"
					columnsM="1"
					columnsL="1"
					columnsXL="1">
					<f:content>
						<Label text="Reason" />
						<TextArea required="true" value="{creditNoteModel>/creditNote}" />
						<Label text="Notify Sales Lead?" />
						<CheckBox selected="{creditNoteModel>/creditNoteNotify}"/>
                        <Label/>
                        <Button press="creditBlockReason" text="Submit" width="200px"/>
					</f:content>
				</f:SimpleForm>
			</VBox>
			
		</content>
	
	</Dialog>
</core:FragmentDefinition>