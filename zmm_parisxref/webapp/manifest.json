                    "localUri": "annotations/annotation0.xml"
                }
            },
            "ZSB_R_PARISXREF_VAN": {
                "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='ZSB_R_PARISXREF_VAN',Version='0001')/$value/",
                "type": "ODataAnnotation",
                "settings": {
                    "localUri": "localService/mainService/ZSB_R_PARISXREF_VAN.xml"
                }
            },
            "mainService": {
                "uri": "/sap/opu/odata/sap/ZSB_R_PARISXREF/",
                "type": "OData",
                "settings": {
                    "annotations": [
                        "ZSB_R_PARISXREF_VAN",
                        "annotation1"
                    ],
                    "localUri": "localService/mainService/metadata.xml",
                    "odataVersion": "2.0"
                }
            },
            "annotation1": {
                "type": "ODataAnnotation",
                "uri": "annotations/annotation1.xml",
                "settings": {
                    "localUri": "annotations/annotation1.xml"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
