                "sap.ui.controllerExtensions": {
                    "sap.suite.ui.generic.template.ObjectPage.view.Details": {
                        "controllerName": "customer.porky.zmmparisxref.ext.controller.ObjectPageExt",
                        "sap.ui.generic.app": {
                            "ZC_ParisMaterialCrossRef": {
                                "EntitySet": "ZC_ParisMaterialCrossRef",
                                "Header": {
                                    "Actions": {
                                        "uploadImage": {
                                            "id": "uploadImageButton",
                                            "text": "Upload Image",
                                            "press": "UploadImage",
                                            "requiresSelection": false
                                        },
                                        "showImage": {
                                            "id": "showImageButton",
                                            "text": "Show Image",
                                            "press": "showImage",
                                            "requiresSelection": false
                                        }
                                    }
                                }
                            }
