{
    "_version": "1.48.0",
    "sap.app": {
        "id": "customer.porky.zmmparisxref",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "0.0.1"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "resources": "resources.json",
        "sourceTemplate": {
            "id": "@sap/generator-fiori:worklist",
            "version": "1.20.2",
            "toolsId": "71d8d338-0a7c-4daf-bbf5-60cfd9477277"
        },
        "dataSources": {
            "annotation0": {
                "type": "ODataAnnotation",
