<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:u="sap.ui.unified"
	xmlns:f="sap.ui.layout.form">
	<Popover
		id="myPopover"
		title="{Name}"
		class="sapUiResponsivePadding--header sapUiResponsivePadding--footer"
		placement="Bottom"
		initialFocus="email">
		<customHeader>
		<f:SimpleForm 
			editable="true"
			layout="ResponsiveGridLayout"
			labelSpanXL="12"
			labelSpanL="12"
			labelSpanM="12"
			labelSpanS="12"
			adjustLabelSpan="true"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="true" >
			<f:content>
<Label text="Location" ></Label>
				<u:Calendar id="calendar1" legend="legend1" intervalSelection="true"  select="onChangeDateRange"/>
			
			</f:content>
		</f:SimpleForm>
		
		</customHeader>
				
		
	</Popover>
</core:FragmentDefinition>
