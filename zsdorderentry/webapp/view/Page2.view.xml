			</IconTabFilter>


			<IconTabFilter text="Fast Entry" key="fastentry">

	<VBox >
	<uitable:Table id="table1"
					
				rows="{cartModel>/materials}"
				visibleRowCount="30"
				selectionMode="MultiToggle"
				title="Materials ({cartModel>/materials/length})"
				ariaLabelledBy="title">
				<uitable:extension>
					<m:OverflowToolbar style="Clear">
						<m:Title text="Fast Entry Materials" />
						<!-- <m:ToolbarSpacer/>
						<m:Input
							id="inputColumn"
							width="20%"
							placeholder="fixed column count"
							tooltip="fixed column count"/>
						<m:Input
							id="inputRow"
							width="20%"
							placeholder="fixed row count"
							tooltip="fixed row count"/>
						<m:Input
							id="inputBottomRow"
							width="20%"
							placeholder="fixed bottom row count"
							tooltip="fixed bottom row count"/> -->
							<m:ToolbarSpacer/>
							
							<m:Button id="button" text="Add +2" press="onAddTwo"/>
						<m:Button id="addItemsCart" text="Add to Cart" press="AddFastItemsToCart"/>
					</m:OverflowToolbar>
				</uitable:extension>
				
				<uitable:columns>
					<uitable:Column width="11rem">
						<m:Label text="Material" />
						<uitable:template>
							<!-- <m:Input value="{cartModel>Material}" showValueHelp="true" /> -->
							<Label text="Customer" />
				<Input  editable="true"  showValueHelp="true" value="{cartModel>Material}" valueHelpRequest="openCustomerF4" 	
				showSuggestion="true"
			showTableSuggestionValueHelp="false"
			suggestionRows="{mainService>/ZI_MATERIAL_VALUEHELP}"
			suggestionItemSelected=".onSuggestionItemSelected"
			maxSuggestionWidth="600px"
			suggest="onSuggestMaterials"
			enableSuggestionsHighlighting="true"
			change="onChangeMaterial"
			>
			<suggestionColumns>
				<Column
					popinDisplay="Inline"
					demandPopin="true">
					<Label text="Material" />
				</Column>
				<Column
					hAlign="Center"
					popinDisplay="Inline"
					demandPopin="true"
					minScreenWidth="Tablet">
					<Label text="MaterialDescription" />
				</Column>
				<Column
					hAlign="Center"
					popinDisplay="Inline"
					minScreenWidth="Tablet">
					<Label text="Plant" />
				</Column>
				<Column
					hAlign="End"
					popinDisplay="Inline"
					demandPopin="true">
					<Label text="OldMaterial" />
				</Column>
				<Column
					hAlign="End"
					popinDisplay="Inline"
					demandPopin="true">
					<Label text="ManufPartNo" />
				</Column>
				<Column
					hAlign="End"
					popinDisplay="Inline"
					demandPopin="true">
					<Label text="Sales Org Material" />
				</Column>
			</suggestionColumns>

			<suggestionRows>
				<ColumnListItem>
					<Label text="{mainService>Material}" />
					<Label text="{mainService>MaterialDescription}" />
					<Label text="{mainService>Plant}" />
					<Label text="{mainService>OldMaterial}" />
					<Label text="{mainService>ManufPartNo}" />
					<Label text="{mainService>SalesOrgMaterial}" />
				</ColumnListItem>
			</suggestionRows>
			</Input>
						</uitable:template>
					</uitable:Column>
					<uitable:Column width="11rem" visible="false">
						<m:Label text="Icon" />
						<uitable:template>
						<Image

						visible="{= ${cartModel>OldMaterial} ? true : false}"
					
					src="https://api.porky.com/images/{cartModel>OldMaterial}.png"
					decorative="true"
					densityAware="false"
					class="sapUiSmallMargin"
					width="80px"
					height="80px">
					<detailBox>
						<LightBox>
							<imageContent>
								<LightBoxItem
									imageSrc="https://api.porky.com/images/{cartModel>OldMaterial}.png"
									title="{cartModel>MaterialDescription}"/>
							</imageContent>
						</LightBox>
					</detailBox>
				</Image>
							<!-- <m:Input value="https://api.porky.com/thumbnails/{cartModel>OldMaterial}.png" editable="false"/> -->
						</uitable:template>
					</uitable:Column>
					<uitable:Column width="11rem">
						<m:Label text="Description" />
						<uitable:template>
							<m:Label text="{cartModel>MaterialDescription}" editable="false"/>
						</uitable:template>
					</uitable:Column>
					<uitable:Column width="6rem" hAlign="End">
						<m:Label text="Old Material" />
						<uitable:template>
							<m:Label text="{cartModel>OldMaterial}" />
						</uitable:template>
					</uitable:Column>
					<uitable:Column width="9rem">
						<m:Label text="Quantity" />
						<uitable:template>
							<m:Input value="{cartModel>Quantity}" type="Number"/>
						</uitable:template>
					</uitable:Column>

		<uitable:Column width="9rem">
						<m:Label text="Unit" />
						<uitable:template>
						<HBox>
								<m:Label text="{cartModel>SalesUnit}"  visible="{= ${cartModel>source} === 'P' ? true : ${cartModel>source} === 'S' ? true : false }"/>
								<m:ComboBox items ="{mainService>/ZI_MATERIAL_SALESUOM}"  selectedKey="{cartModel>SalesUnit}" visible="{= ${cartModel>source} === ('P') ? false : ${cartModel>source} === ('S') ? false : ${cartModel>Material} === '' ? false : true   }">
									<core:Item key="{mainService>SalesUnit}" text="{mainService>SalesUnit}" />

								</m:ComboBox >
						</HBox>		
						</uitable:template>
					</uitable:Column>



					<uitable:Column width="9rem">
						<m:Label text="Price" />
						<uitable:template>
							<m:Input value="{cartModel>CurrentPrice}" type="Number" editable="false"/>
						</uitable:template>
					</uitable:Column>



								<uitable:Column width="9rem">
						<m:Label text="Price" />
						<uitable:template>
							<m:Input value="{cartModel>CurrentPrice_F}" type="Number"/>
						</uitable:template>
					</uitable:Column>





					<uitable:Column width="9rem">
						<m:Label text="Price UoM" />
						<uitable:template>
							<m:Label value="{cartModel>CurrentPriceUnit}" />

							<HBox>
								<m:Label text="{cartModel>PriceUnit}"  visible="{= ${cartModel>source} === 'P' ? true : ${cartModel>source} === 'S' ? true : false }"/>
							<m:ComboBox items ="{mainService>/ZI_MATERIAL_PRICEUOM}"  selectedKey="{cartModel>CurrentPriceUnit}" visible="{= ${cartModel>source} === ('P') ? false : ${cartModel>source} === ('S') ? false : ${cartModel>Material} === '' ? false : true   }">
									<core:Item key="{mainService>PriceUnit}" text="{mainService>PriceUnit}" />

								</m:ComboBox >
						</HBox>	
							
						</uitable:template>
					</uitable:Column>




					<uitable:Column width="12rem">
						<m:Label text="Item Notes" />
						<uitable:template>
							<m:Input value="{cartModel>ItemNotes}" />
						</uitable:template>
					</uitable:Column>
					
			


					<uitable:Column width="9rem">
						<m:Label text="Remove" />
						<uitable:template>
							<m:Button icon="sap-icon://sys-cancel" type="Reject" press="onClearValues"/>
						</uitable:template>
					</uitable:Column>
					
				</uitable:columns>
			</uitable:Table>

			</VBox>
			</IconTabFilter>
			
		</items>
	</IconTabBar>


        </content>
    </Page>
