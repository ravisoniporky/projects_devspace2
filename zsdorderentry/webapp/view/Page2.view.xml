						</LightBox>
					</detailBox>
				</Image>
				<VBox class="sapUiTinyMargin">

						<HBox>

						<Label text="Stock:" class="sapUiTinyMarginEnd"></Label>
						<Label text="{itemSearchModel>Stock} {itemSearchModel>SalesUnit}" vAlign="Inherit"></Label>
