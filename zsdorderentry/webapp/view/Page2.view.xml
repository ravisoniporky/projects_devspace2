						<FlexItemData growFactor="1" shrinkFactor="0" /><!-- Don't shrink below minimum size. Fill space if available. -->
					</layoutData><VBox class="sapUiSmallMargin">
<Title text=" {itemSearchModel>ExternalMaterialGroup} {itemSearchModel>Material} {itemSearchModel>OldMaterial} {itemSearchModel>MaterialDescription}" wrapping="true" width="100%" titleStyle="H6" />
