					<f:GridList
			id="gridList2"
			headerText="Available To Sell "
			items="{path:'itemSearchModel>/results',
			
				sorter: {
					path: 'isAddedToCart',
					descending: false,
					group: true
				}}">
				<f:customLayout>
				<grid:GridBoxLayout boxMinWidth="17rem"/>
			</f:customLayout>



				
					<f:GridListItem class="sapUiSmallMargin" counter="{itemSearchModel>CartQuantity}" 	highlight="{= ${itemSearchModel>isAddedToCart} === true ? 'Warning' : 'None'}">
								



<VBox>

