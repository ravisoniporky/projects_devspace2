	xmlns:core="sap.ui.core" xmlns:uitable="sap.ui.table"
	xmlns:t="sap.tnt" id="view2">
    <Page id="page2" title="Item Selection" showNavButton="true" navButtonTooltip="Go To Home" navButtonPress="onNavButtonPress">
	<headerContent>
	<Toolbar >
	
			
				<!-- <Button
						icon="sap-icon://cart"
					text=""
					type="Emphasized"
					press=".openCart" /> -->
					<Button
					type="Emphasized"
					press=".openCart"
					id="BadgedButton"
					class="sapUiTinyMarginBeginEnd"
					icon="sap-icon://cart"
					>
					<customData>
						<BadgeCustomData
							key="badge"
							value="{countModel>/cartItemsCount}"
							visible="true"
							animation="Full"/>
					</customData>
				</Button>
			</Toolbar>
		</headerContent>
        <content >

        	<IconTabBar
		id="idIconTabBarNoIcons"
		expanded="{device>/isNoPhone}"
		class="sapUiResponsiveContentPadding"
        headerMode="Inline">
		<items>
			<IconTabFilter text="Proposed" key="Proposed">
				<!-- <Text text="Proposed" /> -->
					
					<SearchField
			
			width="50%"
			placeholder="Search for items"
			enableSuggestions="true"
			search=".onSuggestItemsProposed"
			suggest=".onSuggestItemsProposed"
			change=".onSuggestItemsProposed"
			>
			<!-- <SuggestionItem text="{MaterialDescription}" description="{path:'Material'} {path:'MaterialDescription'}" key="{OldMaterial}" /> -->
		</SearchField>

					 <!-- <smartList:SmartList id="smartListAllItemsProposal" listType="List" beforeRebindList="onBeforeRebindList"  entitySet="ZCSD_OENT_ITEMPROPOSALSet" header="Item Proposals"
				showRowCount="false" showFullScreenButton="true" enableAutoBinding="true"
				selectFields="MaterialDescription,ExternalMaterialGroup,OldMaterial,Quantity,ImageURL,ThumbnailURL,Stock">
				<smartList:listItemTemplate> -->
					<!-- <StandardListItem title="{MaterialDescription}" info="{OldMaterial}"
						description="{OldMaterial}" /> -->
	 
						
				<!-- </smartList:listItemTemplate> -->
			<!-- </smartList:SmartList>  -->
			<f:GridList
			id="gridList1"
			headerText="Proposed Items"
			items="{path:'proposedModel>/results',
			
				sorter: {
					path: 'isAddedToCart',
					descending: false,
					group: true
				}}">
				<f:customLayout>
				<grid:GridBoxLayout boxMinWidth="17rem"/>
			</f:customLayout>

							<f:GridListItem class="sapUiSmallMargin"
							counter="{proposedModel>CartQuantity}" 	highlight="{= ${proposedModel>isAddedToCart} === true ? 'Warning' : 'None'}">
								
	<VBox>
							
					<VBox height="100%" justifyContent="SpaceBetween">
					<layoutData>
						<FlexItemData growFactor="1" shrinkFactor="0" /><!-- Don't shrink below minimum size. Fill space if available. -->
					</layoutData>

					<VBox class="sapUiSmallMargin">
						<Title text=" {proposedModel>ExternalMaterialGroup} {proposedModel>Material} {proposedModel>OldMaterial} {proposedModel>MaterialDescription}" wrapping="true" width="100%" titleStyle="H6" />
						<HBox >
						<Image
					
					src="{proposedModel>ThumbnailURL}"
					decorative="true"
					densityAware="false"
					class="sapUiTinyMargin"
					width="80px"
					height="80px">
					<detailBox>
						<LightBox id="lightBox">
							<imageContent>
								<LightBoxItem
									imageSrc="{proposedModel>ImageURL}"
									title="{proposedModel>MaterialDescription}"/>
							</imageContent>
						</LightBox>
					</detailBox>
				</Image>
				<VBox class="sapUiTinyMargin">

						<HBox>
						<Label text="Stock:" class="sapUiTinyMarginEnd sapUiTinyMarginTop"></Label>
						<HBox>
						<Label text="{proposedModel>Stock} {proposedModel>SalesUnit}" vAlign="Inherit" class="sapUiTinyMarginTop sapUiTinyMarginEnd"></Label>
						
						</HBox>
						</HBox>

						<HBox>
						<Label text="Current Price:" class="sapUiTinyMarginEnd"></Label>
						<Label text="{proposedModel>CurrentPrice} {proposedModel>CurrentPriceUnit}" vAlign="Inherit"></Label>
						</HBox>

						<HBox>
						<Label text="Price:" class="sapUiTinyMarginEnd sapUiTinyMarginTop" vAlign="Middle"></Label>
						<Input value="{proposedModel>CurrentPrice_F}" />
						</HBox>


						<!-- <Label text="{proposedModel>OldMaterial}" wrapping="true" class="sapUiTinyMarginBottom" width="100%"/>
						<Text text="{proposedModel>ExternalMaterialGroup} - Stock ({proposedModel>Stock} {proposedModel>SalesUnit})" wrapping="true" width="100%"/>
						<ObjectStatus text="{= ${proposedModel>isAddedToCart} === true ? 'Added To Cart' : ''}  {proposedModel>CartQuantity}" 
						state="{= ${proposedModel>isAddedToCart} === true ? 'Warning' : 'Success'}"  />  -->
						</VBox>
						</HBox>
						<TextArea value="{proposedModel>ItemNotes}" width="100%" placeholder="Item Notes"/>
						
					</VBox>
					
				</VBox>
				

	<OverflowToolbar >
				<ToolbarSpacer/>
					<HBox class="sapUiSmallMargin">
				<StepInput
						value="{proposedModel>Quantity}"
						min="0"
						max="9999"
						width="100px"
						step="1"
						
						largerStep="{largerStep}"
						stepMode="{stepMode}"
						valueState="{valueState}"
						enabled="{enabled}"
						editable="{editable}"
						description="{description}"
						fieldWidth="{fieldWidth}"
						textAlign="{textAlign}"
						validationMode="{validationMode}"
						change="onChange"/>
						<m:ComboBox items ="{proposedModel>to_SalesUnit/results}" selectedKey="{proposedModel>SalesUnit}" width="50px" class="sapUiTinyMarginBegin sapUiMediumMarginEnd">
									<core:Item key="{proposedModel>SalesUnit}" text="{proposedModel>SalesUnit}" />

						</m:ComboBox >
						<!-- <Label text="{proposedModel>SalesUnit}" class="sapUiTinyMarginBegin sapUiTinyMarginEnd sapUiTinyMarginTop" design="Bold"></Label> -->
				<Button
						icon="sap-icon://cart-4"
					text=""
					type="Emphasized"
					press=".onAddToCart" >
					<layoutData><OverflowToolbarLayoutData priority="NeverOverflow" /></layoutData>
				</Button>
				</HBox>
					
				</OverflowToolbar>
				</VBox>
						
					
					
			</f:GridListItem>

			</f:GridList>
			</IconTabFilter>













			<IconTabFilter text="Item Search" key="search">
				
					<SearchField
			
			width="50%"
			placeholder="Search for items"
			enableSuggestions="true"
			search=".onSearchItemSearch"
			change=".onSearchItemSearch"
			suggest=".onSearchItemSearch1"
			>
			<!-- <SuggestionItem text="{MaterialDescription}" description="{path:'Material'} {path:'MaterialDescription'}" key="{OldMaterial}" /> -->
		</SearchField>
				<!-- <smartList:SmartList  id="smartListAllItems" beforeRebindList="onBeforeRebindList1"  entitySet="ZCSD_OENT_AVAILABLETOSELL" header="All Item"
				showRowCount="false" showFullScreenButton="true" enableAutoBinding="true"
				selectFields="Material,OldMaterial,MaterialDescription,Plant,ExternalMaterialGroup,SalesOrgMaterial,VariableSalesUnitNotAllowed,Quantity,SalesUnit,PurchaseDate,Stock,PurchaseQuantity,CWTMaterial,ImageURL,ThumbnailURL">
