					<Label text="{mainService>SalesOrganization_Text}" />
				
				</ColumnListItem>
			</suggestionRows>
			</Input>  -->

			<Label text=" {userValues>/salesorgname}" class="sapUiTinyMargin"></Label>
			</HBox>




				<Label text="Customer" />
				<HBox >
				<Input id="idInputCustomer" enabled="false"  showValueHelp="true" value="{userValues>/Customer}" valueHelpRequest="openCustomerF4" 	
				showSuggestion="true"
			showTableSuggestionValueHelp="true"
			suggestionRows="{/zi_customer_valuehelp}"
			suggestionItemSelected=".onSuggestionItemSelected"
			suggest="onSuggestCustomer"
			maxSuggestionWidth="600px"
			width="150px">
			<suggestionColumns>
				<Column
					popinDisplay="Inline"
					demandPopin="true">
					<Label text="Customer" />
				</Column>
				<Column
					hAlign="Center"
					popinDisplay="Inline"
					demandPopin="true"
					minScreenWidth="Tablet">
					<Label text="Name" />
				</Column>
				<Column
					hAlign="Center"
					popinDisplay="Inline"
					minScreenWidth="Tablet">
					<Label text="Sales Org" />
				</Column>
				<Column
					hAlign="End"
					popinDisplay="Inline"
					demandPopin="true">
					<Label text="Address" />
				</Column>
			</suggestionColumns>

			<suggestionRows>
				<ColumnListItem>
					<Label text="{Customer}" />
					<Label text="{CustomerName}" />
					<Label text="{SalesOrg}" />
					<Label text="{Street} {City} " />
				</ColumnListItem>
			</suggestionRows>
			</Input>
			<Label text=" {userValues>/customername}" class="sapUiTinyMargin"></Label>
			</HBox>

				<!-- <sf:SmartField changeModelValue="onSelectCustomer" modelContextChange="onSelectCustomer"
				 change="onSelectCustomer" showSuggestion="true" id="idCust" textInEditModeSource="ValueList" 
				 value="{Customer}" entitySet="ZCSD_OENT_FILTERS" valueListChanged="onSelectMaterial" width="auto" showLabel="true"
				  editable="true" uomEditable="true" contextEditable="true" >
            <sf:configuration>
                <sf:Configuration preventInitialDataFetchInValueHelpDialog="false" displayBehaviour="idAndDescription"/>
            </sf:configuration>
        </sf:SmartField>  -->

				

				<Label text="Plant" />
				<!-- <Input  showValueHelp="true" value="{userValues>/plant}" /> -->
				<!-- <sf:SmartField 
				 change="onSelectPlant" showSuggestion="true" id="idPlant" textInEditModeSource="ValueList" 
