					<Label text="{mainService>PlantName}" />
				
				</ColumnListItem>
			</suggestionRows>
			</Input>  -->
			<Label text=" {userValues>/plantname}" class="sapUiTinyMargin"></Label>
			</HBox>






				<Label text="PO Number" />
				<Input  showValueHelp="true" value="{userValues>/ponumber}" id="idPonumber" />

				<Label text="Delivery Date"  />
				<DatePicker value="{path: 'userValues>/deldate', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'MM/dd/yyyy', strictParsing: false , UTC: true}}"  id="idDelDate" />

<Label text=""  />
<HBox alignContent="Center" alignItems="Center" width="100%" justifyContent="Center">
				<Button
					icon="sap-icon://begin"
					text="Start Order Entry"
					type="Success"
					press=".showAddMaterials" 
					class="sapUiTinyMargin">
					<layoutData><OverflowToolbarLayoutData priority="NeverOverflow" /></layoutData>
				</Button>

				<Button
					icon="sap-icon://reset"
					text="Reset"
					type="Reject"
					class="sapUiTinyMargin"
					press=".ResetMaterialSelection" >
					<layoutData><OverflowToolbarLayoutData priority="NeverOverflow" /></layoutData>
				</Button>

				</HBox>

			
			</f:content>
		</f:SimpleForm>
