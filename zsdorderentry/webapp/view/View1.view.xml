<HBox>


		<ComboBox id="idInputSalesOrg" items="{mainService>/I_SalesOrganization}" selectionChange=".onSuggestionItemSelectedSalesOrg"  selectedKey="{userValues>/SalesOrganization}">
		
		<core:Item key="{mainService>SalesOrganization}" text="{mainService>SalesOrganization_Text} - {mainService>SalesOrganization}" ></core:Item>
		</ComboBox>
