				  editable="true" uomEditable="true" contextEditable="true">
            <sf:configuration>
                <sf:Configuration preventInitialDataFetchInValueHelpDialog="false" displayBehaviour="idAndDescription"/>
            </sf:configuration>
        </sf:SmartField>  -->



			<HBox>
			<Select id="idInputPlant" items="{plantModel>/plants}" selectionChange=".onSuggestionItemSelectedPlant"  selectedKey="{userValues>/Plant}">
		
		<core:Item key="{plantModel>Plant}" text="{plantModel>Plant} - {plantModel>PlantName}" ></core:Item>
		</Select>
			<!-- <Input id="idInputPlant"   showValueHelp="true" value="{userValues>/Plant}" valueHelpRequest="openSalesOrgF4" 	
				showSuggestion="true"
			showTableSuggestionValueHelp="true"
			suggestionRows="{mainService>/I_Plant}"
			suggestionItemSelected=".onSuggestionItemSelectedPlant"
			>
			<suggestionColumns>
				<Column
					popinDisplay="Inline"
					demandPopin="true">
					<Label text="Plant" />
				</Column>
			
				<Column
					hAlign="Center"
					popinDisplay="Inline"
					minScreenWidth="Tablet">
					<Label text="Plant Name" />
				</Column>
				
			</suggestionColumns>

			<suggestionRows>
				<ColumnListItem>
