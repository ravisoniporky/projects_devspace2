{
  "_version": "1.48.0",
  "sap.app": {
    "id": "customer.porky.zsdorderentry",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.17.0",
      "toolsId": "462dc41e-6f93-42bb-81be-1247d0e4d1a6"
    },
    "dataSources": {
      "ZSB_SD_ORDER_ENTRY_VAN": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='ZSB_SD_ORDER_ENTRY_VAN',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/mainService/ZSB_SD_ORDER_ENTRY_VAN.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZSB_SD_ORDER_ENTRY/",
        "type": "OData",
        "settings": {
          "annotations": [
            "ZSB_SD_ORDER_ENTRY_VAN"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "ZODATA_ORDER_ENTRY_SRV": {
        "uri": "/sap/opu/odata/sap/ZODATA_ORDER_ENTRY_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/ZODATA_ORDER_ENTRY_SRV/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.108.44",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "customer.porky.zsdorderentry.i18n.i18n",
          "useBatch": false
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "useBatch": false
        }
      },
      "mainService": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "useBatch": false
        }
      },
      "userValues": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "cartModel": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "countModel": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "ZODATA_ORDER_ENTRY_SRV": {
        "dataSource": "ZODATA_ORDER_ENTRY_SRV",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "customer.porky.zsdorderentry.view",
        "controlId": "layout",
        "controlAggregation": "midColumnPages"
      },
      "routes": [
        {
          "name": "master",
          "pattern": "",
          "target": [
            "home",
            "Page2",
            "Page3"
          ]
        },
        {
          "name": "detail",
          "pattern": "detail",
          "target": [
            "home",
            "detail",
            "Page3"
          ]
        },
        {
          "name": "product",
          "pattern": "product",
          "target": [
            "home",
            "Page2",
            "Page3"
          ]
        }
      ],
      "targets": {
        "home": {
          "name": "Home",
          "level": 0,
          "controlAggregation": "beginColumnPages",
          "viewId": "View1",
          "viewName": "View1"
        },
        "detail": {
          "name": "Home",
          "level": 1,
          "controlAggregation": "midColumnPages",
          "viewId": "Page2",
          "viewName": "Page2"
        },
        "product": {
          "name": "product",
          "level": 2,
          "controlAggregation": "endColumnPages",
          "viewId": "Page3",
          "viewName": "Page3"
        },
        "TargetView1": {
          "viewType": "XML",
          "transition": "slide",
          "controlAggregation": "beginColumnPages",
          "level": 0,
          "viewId": "View1",
          "viewName": "View1"
        },
        "Page2": {
          "viewType": "XML",
          "transition": "slide",
          "level": 1,
          "controlAggregation": "midColumnPages",
          "viewId": "Page2",
          "viewName": "Page2"
        },
        "Page3": {
          "viewType": "XML",
          "transition": "slide",
          "level": 2,
          "controlAggregation": "endColumnPages",
          "viewId": "Page3",
          "viewName": "Page3"
        }
      }
    },
    "rootView": {
      "viewName": "customer.porky.zsdorderentry.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    }
  }
}
