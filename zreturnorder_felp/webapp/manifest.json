{
    "_version": "1.73.1",
    "sap.app": {
        "id": "customer.porky.zreturnorderfelp",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "0.0.1"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "resources": "resources.json",
        "sourceTemplate": {
            "id": "@sap/generator-fiori:lrop",
            "version": "1.31.1",
            "toolsId": "b6016f80-b05b-4cad-93b1-5967f36223a3"
        },
        "dataSources": {
            "ZC_RETURNORDERSUMMARY_CDS_VAN": {
                "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='ZC_RETURNORDERSUMMARY_CDS_VAN',Version='0001')/$value/",
                "type": "ODataAnnotation",
                "settings": {
                    "localUri": "localService/mainService/ZC_RETURNORDERSUMMARY_CDS_VAN.xml"
                }
            },
            "annotation": {
                "type": "ODataAnnotation",
                "uri": "annotations/annotation.xml",
                "settings": {
                    "localUri": "annotations/annotation.xml"
                }
            },
            "mainService": {
                "uri": "/sap/opu/odata/sap/ZC_RETURNORDERSUMMARY_CDS/",
                "type": "OData",
                "settings": {
                    "annotations": [
                        "ZC_RETURNORDERSUMMARY_CDS_VAN",
                        "annotation"
                    ],
                    "localUri": "localService/mainService/metadata.xml",
                    "odataVersion": "2.0"
                }
            },
            "attachmentService": {
                "uri": "/sap/opu/odata/sap/CV_ATTACHMENT_SRV/",
                "type": "OData",
                "settings": {
                    "odataVersion": "2.0"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": true,
        "dependencies": {
            "minUI5Version": "1.136.16",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ushell": {},
                "sap.f": {},
                "sap.ui.comp": {},
                "sap.ui.generic.app": {},
                "sap.suite.ui.generic.template": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "customer.porky.zreturnorderfelp.i18n.i18n"
                }
            },
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "defaultBindingMode": "TwoWay",
                    "defaultCountMode": "Inline",
                    "refreshAfterChange": false,
                    "metadataUrlParams": {
                        "sap-value-list": "none"
                    }
                }
            },
            "@i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "uri": "i18n/i18n.properties"
            },
            "attachmentModel": {
                "dataSource": "attachmentService",
                "settings": {
                    "defaultBindingMode": "OneWay",
                    "defaultCountMode": "None",
                    "disableHeadRequestForToken": true
                }
            }
        },
        "resources": {
            "css": []
        },
        "routing": {
            "config": {},
            "routes": [],
            "targets": {}
        },
        "extends": {
            "extensions": {
                "sap.ui.controllerExtensions": {
                    "sap.suite.ui.generic.template.ListReport.view.ListReport": {
                        "controllerName": "customer.porky.zreturnorderfelp.ext.controller.ListReportExt",
                        "sap.ui.generic.app": {
                            "ZC_RETURNORDERSUMMARY": {
                                "EntitySet": "ZC_RETURNORDERSUMMARY",
                                "Actions": {
                                    "getAttachments": {
                                        "id": "getAttachmentsButton",
                                        "text": "Attachments",
                                        "press": "GetAttachments",
                                        "requiresSelection": true
                                    },
                                    "createInvoice": {
                                        "id": "createInvoiceButton",
                                        "text": "Preview Invoice",
                                        "press": "previewInvoice",
                                        "requiresSelection": true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "sap.ui.generic.app": {
        "_version": "1.3.0",
        "settings": {
            "forceGlobalRefresh": false,
            "objectPageHeaderType": "Dynamic",
            "considerAnalyticalParameters": true,
            "showDraftToggle": false
        },
        "pages": {
            "ListReport|ZC_RETURNORDERSUMMARY": {
                "entitySet": "ZC_RETURNORDERSUMMARY",
                "component": {
                    "name": "sap.suite.ui.generic.template.ListReport",
                    "list": true,
                    "settings": {
                        "condensedTableLayout": true,
                        "smartVariantManagement": true,
                        "filterSettings": {
                            "dateSettings": {
                                "useDateRange": true
                            }
                        },
                        "tableSettings": {
                            "type": "AnalyticalTable"
                        },
                        "variantManagementHidden": false
                    }
                }
            }
        }
    },
    "sap.fiori": {
        "registrationIds": [],
        "archeType": "transactional"
    }
}