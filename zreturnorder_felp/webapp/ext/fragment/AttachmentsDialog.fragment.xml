<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="attachmentsDialog"
        title="{i18n>attachmentsDialogTitle}"
        contentWidth="32rem"
        contentHeight="24rem"
        resizable="true"
        draggable="true"
        busy="{attachments>/busy}">
        <content>
            <List
                items="{attachments>/results}"
                noDataText="{i18n>attachmentsNoData}">
                <StandardListItem
                    title="{attachments>Filename}"
                    description="{attachments>Source}"
                    icon="sap-icon://attachment"
                    type="Active"
                    press="onAttachmentPress" />
            </List>
        </content>
        <beginButton>
            <Button text="{i18n>attachmentsDialogClose}" press="onCloseAttachmentsDialog" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
