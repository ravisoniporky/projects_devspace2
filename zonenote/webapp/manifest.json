{
  "_version": "1.48.0",
  "sap.app": {
    "id": "customer.porky.zonenote",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.27.0",
      "toolsId": "65142db8-8f05-43e7-8082-2bef9fb9239d"
    },
    "dataSources": {
      "ZCXA_USERDEFAULT_CDS_VAN": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='ZCXA_USERDEFAULT_CDS_VAN',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/mainService/ZCXA_USERDEFAULT_CDS_VAN.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZCXA_USERDEFAULT_CDS/",
        "type": "OData",
        "settings": {
          "annotations": [
            "ZCXA_USERDEFAULT_CDS_VAN"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "zoneNoteService": {
        "uri": "/sap/opu/odata4/sap/zui_zonenotehdr_o4/srvd/sap/zui_zonenotehdr_o4/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      },
      "materialVerify": {
        "uri": "/sap/opu/odata4/sap/zsb_materialverifyv4/srvd/sap/v4/0001/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/v4/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.108.44",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "customer.porky.zonenote.i18n.i18n"
        }
      },
      "zonenote": {
        "dataSource": "zoneNoteService",
        "settings": {
                    "groupId": "$direct",
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupProperties": {
            "zonenoteGroup": {
              "submit": "API"
            }
          }
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
        }
      },
      "materialVerify": {
        "dataSource": "materialVerify",
        "preload": true,
        "settings": {
          "groupId": "$direct",
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ],
      "js": [
        {
          "uri": "lib/jspdf.umd.min.js"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "customer.porky.zonenote.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "name": "RouteView1",
          "pattern": ":?query:",
          "target": [
            "TargetView1"
          ]
        }
      ],
      "targets": {
        "TargetView1": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "View1",
          "viewName": "View1"
        }
      }
    },
    "rootView": {
      "viewName": "customer.porky.zonenote.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    }
  },
  "customer.porky.zonenote": {
    "graph": {
      "defaultUrl": "https://porkyproducts-my.sharepoint.com/:o:/r/personal/ismael_rodriguez_porky_com/_layouts/15/guestaccess.aspx?share=IgC2DLIXdYjzSIK2JOatSzBBAYHJU0Qt-s9pADRihFuXHYk&e=hOcz01"
    }
  }
}
