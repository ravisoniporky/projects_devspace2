<core:FragmentDefinition xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
	xmlns:smartTable="sap.ui.comp.smarttable"
	xmlns:html="http://www.w3.org/1999/xhtml"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<Dialog contentHeight="80%" title="Select Commodity">

		<smartFilterBar:SmartFilterBar id="ZBSD_MOBILECATALOGINCBYCommo_sf" entitySet="ZBSD_MOBILECATALOGINCBYCommo" enableBasicSearch="true" useToolbar="false" persistencyKey="ZBSD_MOBILECATALOGINCBYCommo_sf">


		</smartFilterBar:SmartFilterBar>
		<smartTable:SmartTable id="ZBSD_MOBILECATALOGINCBYCommo_st" entitySet="ZBSD_MOBILECATALOGINCBYCommo"
		 smartFilterId="ZBSD_MOBILECATALOGINCBYCommo_sf"
		  requestAtLeastFields="SalesOrganization,Commodity,CatalogGroup,CatalogGroupName"
		   beforeRebindTable="onBeforeRebindCommodityF4" tableType="ResponsiveTable"
		    useExportToExcel="true" beforeExport="onBeforeExport" useVariantManagement="true"
			 useTablePersonalisation="true" header="Commodities" showRowCount="true" persistencyKey="ZBSD_MOBILECATALOGINCBYCommo_st"
			  enableAutoBinding="true" class="sapUiResponsiveContentPadding" enableAutoColumnWidth="true" app:useSmartToggle="true">
<OverflowToolbar design="Transparent">
				<ToolbarSpacer/>
				<Label text="Select Department - "></Label>
				<ComboBox items="{
					path: '/ZI_DepartmentVH'
					
				}" id="commodityDepartment">
				
					<core:Item key="{Deparatment}" text="{DeparatmentDescription}" />
				</ComboBox>
			</OverflowToolbar>

			<Table mode="SingleSelectMaster" itemPress="handleCommoditySelection" selectionChange="handleCommoditySelection"></Table>



		</smartTable:SmartTable>

		<SearchField search="handleSearchCustomer" visible="false"></SearchField>



		<endButton>
			<Button text="Close" press="onCloseDialogBox" type="Reject"></Button>
		</endButton>
	</Dialog>
</core:FragmentDefinition>