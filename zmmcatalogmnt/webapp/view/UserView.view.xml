			  enableAutoColumnWidth="true" >


			


			<uitable:Table rowSelectionChange="onTableRowSelectionChange" selectionMode="Single" selectionBehavior="Row" >
			
			
			</uitable:Table>		



					</smartTable:SmartTable>
        </content>
