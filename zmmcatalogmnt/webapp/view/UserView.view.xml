xmlns:uitable="sap.ui.table" xmlns:core="sap.ui.core"
	height="100%"
	busyIndicatorDelay="0"
>

 <Page id="page1" title="{i18n>title}">
        <content>



 <smartFilterBar:SmartFilterBar id="smartFilter_custF4_map" entitySet="ZRSD_MOEGetCatalog" useToolbar="true"
			 persistencyKey="catalogmaintenance_f"   enableBasicSearch="true" advancedMode="false" filterBarExpanded="false" smartVariant="true" showAllFilters="true"
			 
				showFilterConfiguration="true"  >

				<smartFilterBar:controlConfiguration>
        <smartFilterBar:ControlConfiguration key="zcatalog" visibleInAdvancedArea="true" preventInitialDataFetchInValueHelpDialog="false" >
            
        </smartFilterBar:ControlConfiguration>


		<smartFilterBar:ControlConfiguration key="$parameter.p_vkorg" mandatory="notMandatory" filterType="single" visibleInAdvancedArea="false" preventInitialDataFetchInValueHelpDialog="false">
            
        </smartFilterBar:ControlConfiguration>
    </smartFilterBar:controlConfiguration>
				

			</smartFilterBar:SmartFilterBar> 


<smartTable:SmartTable id="smartTable_custF4_map" entitySet="ZRSD_MOEGetCatalog"  smartFilterId="smartFilter_custF4_map"
				growing="true"
				growingThreshold ="20"
