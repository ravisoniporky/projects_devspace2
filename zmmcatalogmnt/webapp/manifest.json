{
  "_version": "1.48.0",
  "sap.app": {
    "id": "customer.porky.zmmcatalogmnt",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.18.1",
      "toolsId": "7cd826db-b1a7-4afb-8924-0df4a7afa4fd"
    },
    "dataSources": {
      "ZSB_C_MOBILECATALOG_VAN": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='ZSB_C_MOBILECATALOG_VAN',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/mainService/ZSB_C_MOBILECATALOG_VAN.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZSB_C_MOBILECATALOG/",
        "type": "OData",
        "settings": {
          "annotations": [
            "ZSB_C_MOBILECATALOG_VAN"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "ZCXA_USERDEFAULT_CDS_VAN": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='ZCXA_USERDEFAULT_CDS_VAN',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/ZCXA_USERDEFAULT_CDS/ZCXA_USERDEFAULT_CDS_VAN.xml"
        }
      },
      "ZCXA_USERDEFAULT_CDS": {
        "uri": "/sap/opu/odata/sap/ZCXA_USERDEFAULT_CDS/",
        "type": "OData",
        "settings": {
          "annotations": [
            "ZCXA_USERDEFAULT_CDS_VAN"
          ],
          "localUri": "localService/ZCXA_USERDEFAULT_CDS/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "fullWidth": true,
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.108.44",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "customer.porky.zmmcatalogmnt.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      },
      "shiptoUserModel": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "GlobalModel": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "ZCXA_USERDEFAULT_CDS": {
        "dataSource": "ZCXA_USERDEFAULT_CDS",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "customer.porky.zmmcatalogmnt.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "name": "RouteView1",
          "pattern": "RouteView1",
          "target": [
            "TargetView1"
          ]
        },
        {
          "name": "TargetView1",
          "pattern": ":?query:",
          "target": [
            "TargetView1"
          ]
        }
      ],
      "targets": {
        "TargetView1": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "View1",
          "viewName": "View1"
        },
        "UserView": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "UserView",
          "viewName": "UserView"
        }
      }
    },
    "rootView": {
      "viewName": "customer.porky.zmmcatalogmnt.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    }
  }
}
