<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form">
	<Popover
		id="myPopover"
		title="{Name}"
		class="sapUiResponsivePadding--header sapUiResponsivePadding--footer"
		placement="Bottom"
		initialFocus="email">
		<customHeader>
		<f:SimpleForm 
			editable="true"
			layout="ResponsiveGridLayout"
			labelSpanXL="3"
			labelSpanL="3"
			labelSpanM="3"
			labelSpanS="7"
			adjustLabelSpan="true"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="true" >
			<f:content>
<Label text="Location" ></Label>
			<!-- <Switch state="{userValues>/location}" change="onChangeSwitchState" >
				<layoutData>
					<FlexItemData growFactor="1" />
				</layoutData>
			</Switch> -->
			<CheckBox selected="{userValues>/location}" select="onChangeSwitchState" >
				<layoutData>
					<FlexItemData growFactor="1" />
				</layoutData>
			</CheckBox>
			</f:content>
		</f:SimpleForm>
		<!-- <HBox>
		<Label text="Location" class="sapUiTinyMargin"></Label>
			<Switch state="true" customTextOff="Location Off" customTextOn="Live Location">
				<layoutData>
					<FlexItemData growFactor="1" />
				</layoutData>
			</Switch>
			</HBox> -->
		</customHeader>
		<Label  text="Set Miles - {userValues>/milesSet}"  class="sapUiTinyMarginBegin sapUiTinyMarginTop"></Label>
				<Slider min="0" max="30" enableTickmarks="true" class="sapUiMediumMarginBottom" width="100%" value="{= ${userValues>/milesSet} === '' ? 0 :  Number(${userValues>/milesSet})}" 
				liveChange="onChangeDistanceMainPage" id="mapSlider" name="Miles" showAdvancedTooltip="true" enabled="{userValues>/location}" >
			<ResponsiveScale tickmarksBetweenLabels="3"/>
			  <customTooltips>
            <!-- <custom:MySliderTooltip /> -->
          </customTooltips>
		</Slider>
		<footer>
			<OverflowToolbar>
				<ToolbarSpacer/>
				<Button
                    text="Change SalesOrg"
                    icon="sap-icon://org-chart"
                    press="onChangeSalesOrg"
                    visible="{= ${visitModel>/Visitid} === 'NEW'? false: true}"
                /> 
			
			</OverflowToolbar>
		</footer>
		<Image src="{ProductPicUrl}" width="15em" densityAware="false" />
	</Popover>
</core:FragmentDefinition>
