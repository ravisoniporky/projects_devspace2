                >
                    <!-- <MessageStrip
                        class="sapUiSmallMarginBottom"
                        text="Visit Details"
                        showIcon="true"
                    /> -->
                    <form:SimpleForm
                        id="visitSF"
                         editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4"
                        labelSpanL="4"
                        labelSpanM="4"
                        labelSpanS="4"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
