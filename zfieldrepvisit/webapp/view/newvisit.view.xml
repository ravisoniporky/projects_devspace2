<mvc:View xmlns:sf="sap.ui.comp.smartfield"
    controllerName="customer.porky.zfieldrepvisit.controller.newvisit"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:ux="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:m="sap.m"
     xmlns:upload="sap.m.upload"
     	xmlns:tnt="sap.tnt"
>
    <Page id="page"  title="{i18n>title} {= ${visitModel>/Visitid} !== 'NEW' ? ' - Visit#'+Number(${visitModel>/Visitid}) +' on '+  ${path: 'visitModel>/Createdatetime', type:'sap.ui.model.type.Date', constraints:{displayFormat:'Date'}}+' by '+${visitModel>/CreatedFullName} : ' - New Visit' } for {customerModel>/CustomerFullName}"
        enableScrolling="false" >
    				<!-- <tnt:InfoLabel class="sapUiTinyMarginTopBottom"  text="{= ${visitModel>/Visitid} !== 'NEW' ? 'Visit#'+Number(${visitModel>/Visitid}) +' by '+${visitModel>/CreatedFullName} : ' - New Visit' }" renderMode="Loose" colorScheme="6" visible="{= ${visitModel>/Visitid} === 'NEW'? false: true}" width="100%" /> -->

    	<headerContent>
         <Button 
        text="Pending Visits ({offlineModel>/pendingCount})"
        icon="sap-icon://download-from-cloud"
        press="onViewPendingVisits"
        visible="{= ${offlineModel>/pendingCount} > 0}"
        type="Transparent"/>
                <Text text="You are not authorized to view this visit {visitModel>/Visitid}"  visible="{= ${authCustomerModel>/authCustomer} === false ? true : false }"/>

                <Button text="New Visit" press="onCreateVisit_Followup" visible="{= ${visitModel>/Visitid} === 'NEW'? false: ${visitModel>/status} === '2'?  true : false}" /> 

                <Button text="{= ${chageModeModel>/changeMode} === true ? 'Display' : 'Edit' }"  icon="{= ${chageModeModel>/changeMode} === true ? 'sap-icon://display' : 'sap-icon://edit' }"    press="onChangeModeSelected"   visible="{= ${visitModel>/Visitid} === 'NEW'? false: true}" />
                                   

                <Button text="Save as Draft"  icon="sap-icon://save"   press="onSaveDraft"  visible="{= ${visitModel>/Visitid} === 'NEW'? ${customerModel>/Customer} !== '' ? ${notesModel>/results/0/Notes} !== '' ? true : false : false : false }" />

                <Button    text="Create Visit"    icon="sap-icon://save"    type="Attention"   press="onCreateDraftVisit"    visible="{= ${visitModel>/status} === '1'?  true : false }"/>

                <Button icon="sap-icon://write-new-document" type="Emphasized" text="This is draft" enabled="false" visible="{= ${visitModel>/status} === '1'?  true : false }"></Button>

                <Button icon="sap-icon://visits" type="Emphasized" text="Prospect Visit" enabled="false"  visible="{= ${prospectModel>/prospect} === true ? true : false}"></Button>

                 
		</headerContent>
        
        <content >

            <Title
			id="WrappingTitle"
			wrapping="true"
            titleStyle="H1"
			text="You are not authorized to view this visit"  visible="{= !${authCustomerModel>/authCustomer} }" />

            
            <Wizard
                id="CreateProductWizard"
                finishButtonText="Finish"
                currentStep="ProductTypeStep"
                class="sapUiResponsivePadding--header sapUiResponsivePadding--content"
                complete="onFinishStep"
                visible="{= ${authCustomerModel>/authCustomer} === false ? false : true }"
                
                
            >
            
                <WizardStep
                    id="ProductTypeStep"
                    title="Visit Store Info"
                    
                    nextStep="keyteamstep"
                    activate="onActivate"
                    validated="{= ${customerModel>/Customer} === '' ? false: ${customerModel>/Customer} === 'undefined' ? false: true}"
                >
                   


                      <form:SimpleForm
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4"
                        labelSpanL="4"
                        labelSpanM="4"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="1"
                        columnsL="1"
                        columnsM="1"
                        singleContainerFullSize="false"
                        id="simpleform_sm"
                    >
                        <core:Title
                            class="porkythemetitle"
                           id="titleid1"
                            text="Ship to Information"
                        />

                        <Label
                            text="Ship to"
                            required="true"
                            class="porkythemelabel"
                        />
                        <HBox width="100%">
                         <Input
                            valueHelpOnly="true"
                            showValueHelp="true"
                            change="onChangeShipTo"
                            placeholder="Select Customer"
                            value="{customerModel>/Customer}"
                            class="porkythemebg"
                            id="idCustomer"
                            valueHelpRequest="onOpenCustomerF4"
                            enabled="{= ${visitModel>/Visitid} === 'NEW'? true: false}"
                            width="250px"
                            visible="{= ${prospectModel>/prospect} === true ? false : true}"

                            
                        /> 
                        
                             <Input
                            valueHelpOnly="true"
                            showValueHelp="true"
                            change="onChangeShipTo_Prospect"
                            placeholder="Select Prospect"
                            value="{customerModel>/Customer}"
                            class="porkythemebg"
                            id="idCustomerProspect"
                            valueHelpRequest="onOpenCustomerF4_Prospect"
                            enabled="{= ${visitModel>/Visitid} === 'NEW'? true: false}"
                            width="200px"
                            visible="{= ${prospectModel>/prospect} === true ? true : false}"

                            
                        /> 

                        <Button text="Prospect"                             visible="{= ${prospectModel>/prospect} === true ? ${visitModel>/Visitid} === 'NEW'? true: false : false}"
 press="onOpenProspect" icon="sap-icon://search" class="sapUiSmallMarginBegin"></Button>

                          </HBox>
                         </form:SimpleForm>



                    	<Table id="idProductsTable2"
		inset="false"
        visible="{= ${customerModel>/Customer} === '' ? false: true}"
		>
		
		
		<columns>
			<Column
				width="12em">
			</Column>
			<Column>
			</Column>
		
		</columns>
		<items>
			<ColumnListItem vAlign="Middle">
				<cells>
					<ObjectIdentifier
						title="Customer Selected"
						/>
					<Text
						text="{customerModel>/Customer}" />
					
				</cells>
			</ColumnListItem>
            		<ColumnListItem vAlign="Middle">
				<cells>
					<ObjectIdentifier
						title="Ship to Name"
						/>
					<Text
						text="{customerModel>/CustomerFullName}" />
					
				</cells>
			</ColumnListItem>
            		<ColumnListItem vAlign="Middle">
				<cells>
					<ObjectIdentifier
						title="Ship to Address"
						/>
					<Text
						text="{customerModel>/StreetName}, {customerModel>/CityName}, {customerModel>/PostalCode}" />
					
				</cells>
			</ColumnListItem>
            		<ColumnListItem vAlign="Middle">
				<cells>
					<ObjectIdentifier
						title="No. Of Visits"
						/>
					<Link
						text="{customerModel>/TotalVisit}" press="onLinkQuickViewPress"/>
					
				</cells>
			</ColumnListItem>
 <ColumnListItem vAlign="Middle">
				<cells>
					<ObjectIdentifier
						title="No. Of Visits (Last 12 Months)"
						/>
					<Text
						text="{customerModel>/Last12Visit}" />
					
				</cells>
			</ColumnListItem>
            <ColumnListItem vAlign="Middle">
				<cells>
					<ObjectIdentifier
						title="Sales Lead"
						/>
					<Text
						text="{customerModel>/SalesLeadName}" />
					
				</cells>
			</ColumnListItem>

            <ColumnListItem vAlign="Middle">
				<cells>
					<ObjectIdentifier
						title="Sales Support"
						/>
					<Text
						text="{customerModel>/SaleSupportName}" />
					
				</cells>
			</ColumnListItem>

           
		</items>
	</Table>








       <Table id="idProductsTable3"
    inset="false"
    headerText="Prospect Pipeline"
    visible="{=  ${customerModel>/Customer} === '' ? false: ${customerModel>/Customer} === 'undefined' ? false: ${prospectModel>/prospect} === true ? true : false}"
>
    <headerToolbar>
        <OverflowToolbar>
            <Title text="Prospect Pipeline" level="H2"/>
            <ToolbarSpacer/>
            <Button 
                id="btnEditProspectPipeline"
                icon="sap-icon://edit"
                text="{= ${prospectPipelineModel>/editMode} ? 'Display' : 'Edit'}"
                press="onToggleProspectEdit"
                visible="{= ${chageModeModel>/changeMode} === true}"
                type="{= ${prospectPipelineModel>/editMode} ? 'Emphasized' : 'Default'}"
            />
            <Button 
                id="btnSaveProspectPipeline"
                icon="sap-icon://save"
                text="Save"
                type="Emphasized"
                press="onSaveProspectPipeline"
                visible="{= ${prospectPipelineModel>/editMode} === true}"
            />
            <Button 
                id="btnCancelProspectPipeline"
                icon="sap-icon://decline"
                text="Cancel"
                press="onCancelProspectEdit"
                visible="{= ${prospectPipelineModel>/editMode} === true}"
            />
        </OverflowToolbar>
    </headerToolbar>
    
    <columns>
        <Column width="33%">
            <Text text="Given Prices"/>
        </Column>
        <Column width="33%">
            <Text text="Proj. Weekly Sales"/>
        </Column>
        <Column width="34%">
            <Text text="Proj. 1st Delv Date"/>
        </Column>
    </columns>
    
    <items>
        <ColumnListItem vAlign="Middle">
            <cells>
                <!-- Given Price Field -->
                <VBox>
                    <Text 
                        text="{= ${customerModel>/PriceExists} === true ? 'Yes' : 'No'}"
                        visible="{= !${prospectPipelineModel>/editMode}}"
                    />
                    <CheckBox 
                        selected="{customerModel>/PriceExists}"
                        visible="{prospectPipelineModel>/editMode}"
                        editable="true"
                    />
                </VBox>

                <!-- Projected Weekly Sales Field -->
                <VBox>
                    <Text
                        text="{
                            path: 'customerModel>/ProjectedSales',
                            type: 'sap.ui.model.type.Float'
                        }"
                        visible="{= !${prospectPipelineModel>/editMode}}"
                    />
                    <Input
                        value="{
                            path: 'customerModel>/ProjectedSales'
                        }"
                        visible="{prospectPipelineModel>/editMode}"
                        type="Number"
                        width="100%"
                    />
                </VBox>

                <!-- Projected First Delivery Date Field -->
                <VBox>
                    <Text
                        text="{
                            path: 'customerModel>/ProjectedDelivery',
                            type: 'sap.ui.model.type.Date',
                            formatOptions: {
                                pattern: 'MM/dd/yyyy',
                                UTC: true
                            }
                        }"
                        visible="{= !${prospectPipelineModel>/editMode}}"
                    />
                    <DatePicker
                        value="{
                            path: 'customerModel>/ProjectedDelivery',
                            type: 'sap.ui.model.type.Date',
                            formatOptions: {
                                pattern: 'MM/dd/yyyy',
                                UTC: true
                            }
                        }"
                        visible="{prospectPipelineModel>/editMode}"
                        width="100%"
                        displayFormat="MM/dd/yyyy"
                    />
                </VBox>
            </cells>
        </ColumnListItem>
    </items>
</Table>


