                        <Text text="{visitModel>/Visitid}" class="porkythemebg "/> -->
                        <Label text="Visit Type" class="porkythemelabel" />
                        <ComboBox selectedKey="{visitModel>/Visittype}" selectionChange="updateVisit_Type"
                         class="porkythemebg" items="{ZRMM_FRVISITV2_CDS>/ZBMM_VISITTYPE}"  editable="{= ${chageModeModel>/changeMode} === true? true : false}">
                            <core:Item
                                key="{ZRMM_FRVISITV2_CDS>Value}"
