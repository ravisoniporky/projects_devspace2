                 <WizardStep
                    id="notes"
                    title="Notes and Comments"
                    activate="onActivateNotes"
                    validationSuccess="onValidationSuccessNotes"
                                        validated="{= (${notesModel>/results/0/Notes}).length > 10 ? true : false}"

                    
                >


                    	<IconTabBar id="idIconTabBar" class="sapUiResponsiveContentPadding" items="{path:'notesModel>/results', sorter: { path: 'visitid_new', descending: true, group: '.getCounty'}}" select="onVisitNoteSelected">

                            	<items>
			<IconTabFilter
				text="Visit ({= isNaN(${notesModel>Visitid}) ? 'NEW': Number(${notesModel>Visitid})}) on {
  path: 'notesModel>Createdatetime',
  type: 'sap.ui.model.type.Date'
  }"
  visible="{= ${notesModel>status} === '1' ? Number(${visitModel>/Visitid}) === Number(${notesModel>Visitid}) ? true : false : true}"
				key="{notesModel>Visitid}"
				>
				<TextArea value="{notesModel>Notes}"  
                editable="{= ${chageModeModel>/changeMode} === true? ${notesModel>editable} === true ? ${visitModel>/Visitid} !== 'NEW' ? true : false : false : false}" 
                valueState="{translateModel>valueState}" width="100%" height="200px" liveChange="onCreateVisit_AutoSave" />
              <HBox>  
              
              <Button text="Spanish" press="translateCallES" class="sapUiSmallMarginEnd" enabled="{= ${translateModel>/lang} === 'English' ?  false : true}"></Button>
                                
                                
                <Button text="English" enabled="{= ${translateModel>/lang} === 'Spanish' ?  false : true}" press="translateCallEN" class="sapUiSmallMarginEnd"></Button>
                <Button text="Original" press="translateCallOrigin" class="sapUiSmallMarginEnd" enabled="{= ${translateModel>/lang} === 'Spanish' ?  true : ${translateModel>/lang} === 'English' ?  true : false}"></Button>
                <Button text="Share" press="shareNotes" visible="{= ${visitModel>/Visitid} === 'NEW' ? false : true}" class="sapUiSmallMarginEnd" ></Button>

            </HBox>
                	

			</IconTabFilter>
            </items>
                        </IconTabBar>


<FeedInput
		post="onPostComments"
         visible="{= ${visitModel>/Visitid} === 'NEW'? false: Number(${currentVisitNoteModel>/Visitid}) === Number(${visitModel>/Visitid})? ${visitModel>/status} === '1' ? false : true: false}"
		icon="test-resources/sap/m/images/dronning_victoria.jpg"
		class="sapUiSmallMarginTopBottom" />
	<List
        visible="{= ${visitModel>/Visitid} === 'NEW'? false:true}"
		showSeparators="Inner"
        id="idFeedComments"
		items="{path:'commentsModel>/results',sorter: { path: '{commentsModel>Createdatetime}', descending: true}}" >
		<FeedListItem
			sender="{commentsModel>Createdby} {commentsModel>Ernam}"
            visible="{= !${commentsModel>Loevm}}"
			icon="{AuthorPicUrl}"
			senderPress="onSenderPress"
			iconPress="onIconPress"
			iconDensityAware="false"
			info="{Type}"
			timestamp="{commentsModel>Createdatetime}"
			text="{commentsModel>Notes}"
			convertLinksToAnchorTags="All">
<FeedListItemAction text="Delete" icon="sap-icon://cancel" key="{Key}" press="onCommentDelete" />
					<FeedListItemAction text="English" icon="sap-icon://translate" key="{Key}" press="onTranslateCommentPressed" />
					<FeedListItemAction text="Español" icon="sap-icon://translate" key="{Key}" press="onTranslateCommentPressed" />
<FeedListItemAction text="Original" icon="sap-icon://undo" key="sap-icon://undo" press="onTranslateCommentPressed" />
            </FeedListItem>
         
	</List>



                </WizardStep>


            





             <WizardStep
                    id="images"
                    title="{= ${visitModel>/Visitid} === 'NEW'? 'Finish': 'Attachments'}"
                    activate="onActivateImages"
              

                >
                   
            	<upload:UploadSet
                visible="{= ${visitModel>/Visitid} === 'NEW'? false: true}"
				id="UploadSet"
                
				instantUpload="true"
				showIcons="true"
				maxFileSize="200"
				mediaTypes="text/plain,application/msword,image/jpeg,image/png,application/pdf"
				uploadUrl="/sap/opu/odata/sap/ZODATA_FIELDREP_IMAGES_V2_SRV/ZFRVISIT_IMAGESSet"
				items="{visitModel>/to_images/results}"
				mode="MultiSelect"
                multiple="false"
				selectionChanged="onSelectionChangeUpload"
                afterItemAdded="onAfterUploadItemAdded"
                
                afterItemRemoved="onBeforeImageRemoved"
                
                uploadEnabled="{chageModeModel>/changeMode}" 
   terminationEnabled="true" maxFileNameLength="120"
   uploadCompleted="onUploadCompleted" 
   fileTypes="jpg,jpeg,png,pdf" 
   fileTypeMismatch="onFileTypeMismatch" fileSizeExceeded="onFileSizeExceeded">
	<upload:toolbar>
				<OverflowToolbar>
					<ToolbarSpacer/>
					<!-- <Button text="Finish Upload" press="onFinishUploadDocuments"   enabled="{chageModeModel>/changeMode}" /> -->
				</OverflowToolbar>
			</upload:toolbar>
			<upload:items>
				<upload:UploadSetItem
                
                visibleEdit="false"
            enabledRemove = "{chageModeModel>/changeMode}"
						fileName="{visitModel>ImageName}"
						mediaType="{visitModel>Mimetype}"
						url="{visitModel>GetUrl}"
						thumbnailUrl="{visitModel>GetThumpUrl}"
                        visibleRemove="{chageModeModel>/changeMode}"
						
						>
					<upload:attributes>
						<ObjectAttribute
								title="Type"
								text="{visitModel>Mimetype}"
								active="{active}"/>
					</upload:attributes>
					<upload:markers>
						<ObjectMarker
								type="{type}"
								visibility="{visibility}"/>
					</upload:markers>
					<upload:statuses>
						<ObjectStatus
								title="{title}"
								text="{text}"
								state="{state}"
								icon="{icon}"
								active="{active}"/>
					</upload:statuses>
				</upload:UploadSetItem>
			</upload:items>
		</upload:UploadSet>

  



                </WizardStep>









            </Wizard>
        </content>
    </Page>
</mvc:View>
