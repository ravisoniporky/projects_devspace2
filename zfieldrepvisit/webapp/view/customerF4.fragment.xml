<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
		xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
	xmlns:smartTable="sap.ui.comp.smarttable"
	xmlns:html="http://www.w3.org/1999/xhtml"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<Dialog contentHeight="80%"
		id="myDialog1_customer"
		noDataText="No Customer Found"
		title="Select Customer"
		search=".handleSearchCustomer"
		confirm=".handleConfirm"
        selectionChange="handleSelectCustomer"
		cancel=".handleClose"
        growing="true"
        growingThreshold="20"
		>

			<smartFilterBar:SmartFilterBar id="smartFilter_custF4" entitySet="ZI_DefaultSHVH"
			   enableBasicSearch="true" useToolbar="false" persistencyKey="smarttableCustF4_filter">
				
				
			</smartFilterBar:SmartFilterBar>
			<smartTable:SmartTable id="smartTable_custF4" entitySet="ZI_DefaultSHVH" smartFilterId="smartFilter_custF4"
				requestAtLeastFields="kunnr,name1,altkn,storeno,stras,ort01,regio,pstlz,sm,ss,hier1_name,vkorg, zzlongitude,zzlatitude,CreditBLock,Deleted"
				beforeRebindTable="onBeforeRebindCustomerF4"
			 tableType="ResponsiveTable" useExportToExcel="true"
			
			 beforeExport="onBeforeExport" useVariantManagement="true" useTablePersonalisation="true" 
			 header="Customers" showRowCount="true" persistencyKey="smarttableCustF4"
			  enableAutoBinding="true" class="sapUiResponsiveContentPadding" 
			  enableAutoColumnWidth="true"  app:useSmartToggle="true">
				<!-- layout data used to make the table growing but the filter bar fixed -->
			

				<Table mode="SingleSelectMaster"  itemPress="handleSelectCustomer" selectionChange="handleSelectCustomer"></Table>



					</smartTable:SmartTable>

						<SearchField search="handleSearchCustomer" visible="false"></SearchField>


		<Table visible="false" items="{
			path : 'ZODATA_FR_SRV>/ZI_DefaultSHVH'
		}" updateFinished="onUpdateFinishedSearchTable" onAfterRendering="onUpdateFinishedSearchTable" 
		  >
		<headerToolbar>
			<OverflowToolbar>
				<Title text="Customers" level="H2"/>
				<ToolbarSpacer/>
				<CheckBox text="Deleted" selected="{searchModel>/deleted}" select="handleSearchCustomer"/>
				<CheckBox text="Credit Block" selected="{searchModel>/CreditBLock}" select="handleSearchCustomer"/>

			</OverflowToolbar>
		</headerToolbar>
		<ColumnListItem vAlign="Middle" press="handleSelectCustomer" type="Navigation">
			<cells>
				<ObjectIdentifier title="{ZODATA_FR_SRV>name1}" />
				<Text text="{ZODATA_FR_SRV>stras} ,{ZI_DefaultSHVH>ort01} ,{ZI_DefaultSHVH>regio} ,{ZI_DefaultSHVH>pstlz}" />
				<Text text="{ZODATA_FR_SRV>hier1_name}" />
				<ObjectNumber
					number="{ZODATA_FR_SRV>kunnr}" />
				<ObjectNumber
					number="{ZODATA_FR_SRV>altkn}"
					 />
					 <ObjectNumber
					number="{ZODATA_FR_SRV>vkorg}"
					 />
					  <ObjectNumber
					number="{ZODATA_FR_SRV>Deleted}"
					 />
					  <ObjectNumber
					number="{= ${ZODATA_FR_SRV>CreditBLock} === false ? 'No' : 'Yes'}"
					 />
			</cells>
		</ColumnListItem  >
		<columns>
			<Column width="12em">
				<header>
					<Text text="Customer Name" />
				</header>
			</Column>
			<Column minScreenWidth="Tablet" demandPopin="true">
				<header>
					<Text text="Address" />
				</header>
			</Column>
			<Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="End">
				<header>
					<Text text="Hierarchy" />
				</header>
			</Column>
			<Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Center">
				<header>
					<Text text="Customer Number" />
				</header>
			</Column>
			<Column hAlign="Center">
				<header>
					<Text text="Prev. Acc. Number" />
				</header>
			</Column>
			<Column hAlign="Center">
				<header>
					<Text text="Sales Org" />
				</header>
			</Column>
			<Column hAlign="Center">
				<header>
					<Text text="Deleted" />
				</header>
			</Column>
			<Column hAlign="Center">
				<header>
					<Text text="Credit Block" />
				</header>
			</Column>
		</columns>
		</Table>
		<endButton>
		<Button text="Close" press="onCloseDialogBox" type="Reject"></Button>
		</endButton>
	</Dialog>
</core:FragmentDefinition>