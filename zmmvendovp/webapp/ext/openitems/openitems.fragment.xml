<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:ovp="sap.ovp.ui" xmlns:smartTable="sap.ui.comp.smarttable" 
xmlns:template="http://schemas.sap.com/sapui5/extension/sap.ui.core.template/1">
            <!-- Card's Content area code goes here -->


            <smartTable:SmartTable
				tableType="Table"
				initiallyVisibleFields="DocumentNumber,DocumentType,Amount,Text,BankID,DocumentDate,DueDate,Overdue,Reference"
				id="openitems"
				entitySet="ZCFI_VENDORDASH_OPENITEMS"
				smartFilterId="smartFilterBar"
				useExportToExcel="true"
				beforeExport="onBeforeExport"
				useVariantManagement="true"
				useTablePersonalisation="true"
				header="Open Items"
				showRowCount="true"
				persistencyKey="tablecontacts"
				enableAutoBinding="true"
				class="sapUiResponsiveContentPadding"
				enableAutoColumnWidth="true"
				beforeRebindTable="onBeforeRebindTable"
				afterVariantApply="onAfterVariantApply1"
				growingThreshold="20"
				showFullScreenButton = "true"
								


			>

				<smartTable:customToolbar>
			<OverflowToolbar design="Transparent">
				<ToolbarSpacer/>
					<!-- <SearchField width="200px" search="onSearchContacts"/> -->
<Button icon="sap-icon://action"
						press="onClickHeader" />
			</OverflowToolbar>
			
		</smartTable:customToolbar>
		</smartTable:SmartTable>



</core:FragmentDefinition>