<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:ovp="sap.ovp.ui" xmlns:smartTable="sap.ui.comp.smarttable" 
xmlns:template="http://schemas.sap.com/sapui5/extension/sap.ui.core.template/1">
            <!-- Card's Content area code goes here -->

            <smartTable:SmartTable
				tableType="Table"
				initiallyVisibleFields="PaymentDocument,PaymentDate,EncashmentDate,CheckNumber,AmountPaid,PaymentMethod,BankID"
				id="recentpayment"
				entitySet="ZCFI_VENDORDASH_RECENTPMNT"
				smartFilterId="smartFilterBar"
				useExportToExcel="true"
				beforeExport="onBeforeExport"
				useVariantManagement="true"
				useTablePersonalisation="true"
				header="Recent Payments"
				showRowCount="true"
				persistencyKey="recentpayment"
				enableAutoBinding="true"
				class="sapUiResponsiveContentPadding"
				enableAutoColumnWidth="true"
				beforeRebindTable="onBeforeRebindTable"
				afterVariantApply="onAfterVariantApply1"
				growingThreshold="20"
				showFullScreenButton = "true"
								


			>

				<smartTable:customToolbar>
			<!-- <OverflowToolbar design="Transparent">
				<ToolbarSpacer/>
					<SearchField width="200px" search="onSearchContacts"/>

			</OverflowToolbar> -->
		</smartTable:customToolbar>

		 <Table growing="true"  >
				
				
				<columns>
				<Column hAlign="Begin">
					<customData>
						<core:CustomData key="p13nData"
										 value='\{"columnKey": "PaymentDocument", "autoColumnWidth": \{ "visibleProperty": "PaymentDocument" }, "columnIndex": 0, "leadingProperty": "PaymentDocument", "sortProperty": "PaymentDocument", "additionalProperty": "PaymentDocument", "additionalSortProperty": "PaymentDocument","type": "String"}' />
					</customData>
					<Text text="Document Number" />
				</Column>
				
			</columns>
			<items>
				<ColumnListItem>
					<cells>
						<ObjectIdentifier title="{PaymentDocument}" titleActive="true" titlePress="onClickPO"/>
					</cells>
					
				</ColumnListItem>
			</items>
				
                </Table>



		</smartTable:SmartTable>



</core:FragmentDefinition>