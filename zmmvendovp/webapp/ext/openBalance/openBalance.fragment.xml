<VBox class="sapUiSmallMargin">
		<f:SimpleForm 
			editable="true"
			layout="ResponsiveGridLayout"
			title="Vendor Balance"
			labelSpanXL="3"
			labelSpanL="3"
			labelSpanM="3"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false" >


			<f:toolbar>
			<Toolbar  >
							<Title text="Open Balance"  />
<ToolbarSpacer />
					
					<Button icon="sap-icon://action"
						press="onClickHeader" />
			</Toolbar>
			</f:toolbar>


			<f:content>
				<ObjectIdentifier title="{/#ZCFI_VENDOR_OEPNBALType/Vendor/@sap:label}" emptyIndicatorMode= "Auto" titleActive="true" />
				<Text  text="{vendorData>/Vendor}" />
				<ObjectIdentifier title="{/#ZCFI_VENDOR_OEPNBALType/OpenBalance/@sap:label}" emptyIndicatorMode= "Auto" titleActive="true" />
				<Text text="{path: 'vendorData>/OpenBalance', type:'sap.ui.model.type.Float'} {vendorData>/Currency}" />
				
	
			
			</f:content>
		</f:SimpleForm>
	</VBox>


</core:FragmentDefinition>