<mvc:View
	controllerName="customer.porky.zfieldappchat.controller.View1"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true">

	<Page id="visitChatPage" title="{i18n>appTitle}" showNavButton="false" enableScrolling="false" class="chatPage">
		<content>
			<VBox height="100%" width="100%">

				<!-- Deep Chat (https://deepchat.dev, MIT licensed) - a free web component chat UI.
				     Loaded dynamically from CDN in the controller; this HTML control just hosts the
				     <deep-chat> tag, which the browser upgrades automatically once the script loads.
				     All actual conversation logic still runs in the controller via connect.handler -
				     this only replaces how messages are rendered. -->
				<core:HTML id="deepChatHost"
					width="100%"
					height="100%"
					content="&lt;div style=&quot;width:100%;height:100%;&quot;&gt;&lt;/div&gt;"
					afterRendering="onDeepChatHostRendered" />

			</VBox>
		</content>
	</Page>
</mvc:View>