						value='\{"columnKey": "PurchStatusValidityDate", "autoColumnWidth": \{ "visibleProperty": "PurchStatusValidityDate" }, "columnIndex": 6, "leadingProperty": "PurchStatusValidityDate", "sortProperty": "PurchStatusValidityDate", "additionalProperty": "PurchStatusValidityDate", "additionalSortProperty": "PurchStatusValidityDate","type": "datetime"}' />
