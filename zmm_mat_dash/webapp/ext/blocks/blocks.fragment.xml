					<!-- <Input selected="{AllSalesStatus}" showValueHelp="true"/> -->



					<ComboBox selectedKey="{SalesStatus}" editable="{Editable}" items="{
					path: '/ZI_MAT_SALESSTATUS_VH'
				}">
						<core:Item key="{SalesMaterialStatus}" text="{SalesMaterialStatusText}" />
					</ComboBox>


				</ui:template>



			</ui:Column>





			<ui:Column hAlign="Begin" width="150px">
				<ui:customData>
					<core:CustomData key="p13nData"
						value='\{"columnKey": "SalesStatusValidityDate", "autoColumnWidth": \{ "visibleProperty": "SalesStatusValidityDate" }, "columnIndex": 8, "leadingProperty": "SalesStatusValidityDate", "sortProperty": "SalesStatusValidityDate", "additionalProperty": "SalesStatusValidityDate", "additionalSortProperty": "SalesStatusValidityDate","type": "datetime"}' />
