	<ui:Table growing="true" rows="{/ZCMM_MATDASH_BLOCKS}" id="ZCMM_MATDASH_BLOCKSTable">




		<ui:columns>
		<ui:Column hAlign="Begin" width="150px">
				<ui:customData>
					<core:CustomData key="p13nData"
						value='\{"columnKey": "Statusmessage", "autoColumnWidth": \{ "visibleProperty": "Statusmessage" }, "columnIndex": 1, "leadingProperty": "Statusmessage", "sortProperty": "Statusmessage", "additionalProperty": "Statusmessage", "additionalSortProperty": "Statusmessage","type": "String"}' />
				</ui:customData>
				<Text text="Status Message" />
				<ui:template>
					<Text text="{Statusmessage}" />
				</ui:template>
			</ui:Column>

			<ui:Column hAlign="Begin" width="150px">
				<ui:customData>
					<core:CustomData key="p13nData"
						value='\{"columnKey": "Material", "autoColumnWidth": \{ "visibleProperty": "Material" }, "columnIndex": 1, "leadingProperty": "Material", "sortProperty": "Material", "additionalProperty": "Material", "additionalSortProperty": "Material","type": "String"}' />
				</ui:customData>
				<Text text="Material" />
				<ui:template>
					<Text text="{Material}" />
				</ui:template>
			</ui:Column>


			
			<ui:Column hAlign="Begin" width="130px" visible="false">
				<ui:customData>
					<core:CustomData key="p13nData"
						value='\{"columnKey": "CentralBlock", "autoColumnWidth": \{ "visibleProperty": "CentralBlock" }, "columnIndex": 1, "leadingProperty": "CentralBlock", "sortProperty": "CentralBlock", "additionalProperty": "CentralBlock", "additionalSortProperty": "CentralBlock","type": "String"}' />
				</ui:customData>
				<Text text="Central Block" />
				<ui:template>
					<!-- <CheckBox selected="{CentralBlock}" /> -->
					<!-- <Switch state="{CentralBlock}" type="AcceptReject" customTextOn="Central" customTextOff="Central"/> -->
						<Button enabled="{Editable}"  press="pressBlockButtonC" active="true" 
						text="{= ${CentralBlock} !== false ? 'Blocked' : 'Unblocked'}"   type="{= ${CentralBlock} !== false ? 'Negative' : 'Accept'}"  inverted="true" icon="{= ${CentralBlock} !== false ? 'sap-icon://error' : 'sap-icon://sys-enter-2'}"/>
		
					<!-- <Switch state="{PlantBlock}" type="Default" customTextOn="Plant" customTextOff="Plant"/>
					<Switch state="{SalesOrgBlock}" type="Default" customTextOn="Sales" customTextOff="Sales"/> -->
				</ui:template>
			</ui:Column>

			<ui:Column hAlign="Begin" width="130px" >
				<ui:customData>
					<core:CustomData key="p13nData"
						value='\{"columnKey": "PlantBlock", "autoColumnWidth": \{ "visibleProperty": "PlantBlock" }, "columnIndex": 2, "leadingProperty": "PlantBlock", "sortProperty": "PlantBlock", "additionalProperty": "PlantBlock", "additionalSortProperty": "PlantBlock","type": "String"}' />
				</ui:customData>
				<Text text="Plant Block" />
				<ui:template>
					<!-- <CheckBox selected="{PlantBlock}" editable="true" /> -->
<!-- <Switch state="{PlantBlock}" type="AcceptReject" visible="true"/> -->
<Button press="pressBlockButtonP" enabled="{Editable}"  active="true" 
						text="{= ${PlantBlock} !== false ? 'Blocked' : 'Unblocked'}"   type="{= ${PlantBlock} !== false ? 'Negative' : 'Accept'}"  inverted="true" icon="{= ${PlantBlock} !== false ? 'sap-icon://error' : 'sap-icon://sys-enter-2'}"/>
			
				</ui:template>
			</ui:Column>

			<ui:Column hAlign="Begin" width="130px" >
				<ui:customData>
					<core:CustomData key="p13nData"
						value='\{"columnKey": "SalesOrgBlock", "autoColumnWidth": \{ "visibleProperty": "SalesOrgBlock" }, "columnIndex": 3, "leadingProperty": "SalesOrgBlock", "sortProperty": "SalesOrgBlock", "additionalProperty": "SalesOrgBlock", "additionalSortProperty": "SalesOrgBlock","type": "String"}' />
				</ui:customData>
				<Text text="SalesOrg Block" />
				<ui:template>
				<!-- <Switch state="{SalesOrgBlock}" type="AcceptReject"/> -->
				<Button enabled="{Editable}" press="pressBlockButtonS" active="true" 
