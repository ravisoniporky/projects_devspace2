				</ui:template>
			</ui:Column>



			<ui:Column hAlign="Begin" width="150px">
				<ui:customData>
					<core:CustomData key="p13nData"
						value='\{"columnKey": "SalesMaterialStatus", "autoColumnWidth": \{ "visibleProperty": "SalesMaterialStatus" }, "columnIndex": 7, "leadingProperty": "SalesMaterialStatus", "sortProperty": "SalesMaterialStatus", "additionalProperty": "SalesMaterialStatus", "additionalSortProperty": "SalesMaterialStatus","type": "String"}' />
				</ui:customData>
